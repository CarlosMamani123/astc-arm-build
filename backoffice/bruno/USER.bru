post {
  url: {{url}}
  body: graphql
}

body {
  mutation {
    createUser(input: {
      username: "alan"
      firstName: "Alan"
      lastName: "Santos"
      email: "alan@test.com"
      phone: "999999999"
      password: "123456"
      roleId: "11111111-1111-1111-1111-111111111111"
    }) {
      id
      username
      email
      roleId
    }
  }
}